# Copy to .env (git-ignored) to change how Crate runs. Everything here is optional.
# Real environment variables (e.g. from a systemd service) take precedence over this file.

# --- Backend -----------------------------------------------------------------
# claude (default): runs Claude Code (`claude -p`). Needs Claude Code installed and logged in.
# openai: any OpenAI-compatible model. Crate runs the MCP servers itself; no Claude Code needed.
CRATE_BACKEND=claude

# --- claude backend ------------------------------------------------------------
# Optional model override, e.g. claude-sonnet-5-5. Blank = Claude Code's default.
# To bill an Anthropic API key instead of a Claude login, also set ANTHROPIC_API_KEY.
CRATE_CLAUDE_MODEL=

# --- openai backend (pick one provider) ----------------------------------------
# OpenRouter:
# CRATE_BASE_URL=https://openrouter.ai/api/v1
# CRATE_API_KEY=sk-or-...
# Any model slug from openrouter.ai/models that supports tool calling:
# CRATE_MODEL=provider/model-name

# OpenAI:
# CRATE_BASE_URL=https://api.openai.com/v1
# CRATE_API_KEY=sk-...
# CRATE_MODEL=your-model-name

# Ollama (local, free):
# CRATE_BASE_URL=http://localhost:11434/v1
# CRATE_API_KEY=ollama
# CRATE_MODEL=your-local-model

# LM Studio (local, free):
# CRATE_BASE_URL=http://localhost:1234/v1
# CRATE_API_KEY=lm-studio
# CRATE_MODEL=your-local-model
